[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/siqn3046/center_agent.git
	fetch = +refs/heads/master:refs/remotes/origin/master
[branch "master"]
	remote = origin
	merge = refs/heads/master
	vscode-merge-base = origin/master
[remote "backup"]
	url = https://github.com/Mtoly/XrayRbackup.git
	fetch = +refs/heads/*:refs/remotes/backup/*
[branch "main"]
	vscode-merge-base = origin/master
[pack]
	threads = 1
	windowMemory = 100m
	packSizeLimit = 100m
