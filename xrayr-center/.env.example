# Copy to .env and adjust. Docker Compose reads these values.
# Production: change POSTGRES_PASSWORD, CENTER_JWT_SECRET, CENTER_PUBLIC_BASE_URL.

POSTGRES_DB=xrayr_center
POSTGRES_USER=xrayr
POSTGRES_PASSWORD=xrayr_center_change_me

CENTER_PORT=8080
CENTER_PUBLIC_BASE_URL=http://localhost:8080
CENTER_JWT_SECRET=please-change-this-secret-min-32chars!!

# Agent binary for install-agent.sh (Mode A: external URL + sha256, both required for a working install script).
CENTER_AGENT_DOWNLOAD_URL=
CENTER_AGENT_SHA256=

# Optional Mode B: place binary at ${CENTER_ARTIFACT_DIR}/${CENTER_AGENT_VERSION}/xrayr-agent (+ sha256 file) inside the volume; requires CENTER_PUBLIC_BASE_URL reachable by nodes.
CENTER_AGENT_VERSION=
CENTER_AGENT_BINARY_NAME=xrayr-agent
