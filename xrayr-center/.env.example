# -----------------------------------------------------------------------------
# 复制为 .env 后按环境修改。Docker Compose 会读取本目录下的 .env 做变量替换。
# 生产环境：必须修改 POSTGRES_PASSWORD、CENTER_JWT_SECRET、CENTER_PUBLIC_BASE_URL。
# -----------------------------------------------------------------------------

# 宿主机映射端口（对应 compose 中 ${CENTER_PORT:-8080}:8080）
CENTER_PORT=8080

# Center 对外访问根 URL，用于生成 Agent 一键安装命令与制品下载链接。
# 示例：http://1.2.3.4:8080 或 https://center.example.com（须与浏览器/节点实际访问一致）
CENTER_PUBLIC_BASE_URL=http://127.0.0.1:8080

# PostgreSQL（与 compose 中 postgres 服务默认值对应；生产请改强密码）
POSTGRES_DB=xrayr_center
POSTGRES_USER=xrayr
POSTGRES_PASSWORD=xrayr_center_change_me

# 管理端 JWT 密钥（生产请改为随机长字符串，建议 32 字符以上）
CENTER_JWT_SECRET=please-change-this-secret-min-32chars!!

# ---------- Agent 一键安装脚本（GET /install-agent.sh）所需 ----------
# 模式 A：外置直链 + sha256（推荐入门；两者必须同时配置，否则脚本无法注入下载信息）
CENTER_AGENT_DOWNLOAD_URL=
CENTER_AGENT_SHA256=

# 模式 B（可选）：在卷 center_artifacts 对应目录放置 Agent 二进制时填写版本目录名等
# 路径约定：${CENTER_ARTIFACT_DIR}/${CENTER_AGENT_VERSION}/xrayr-agent 及 sha256 文件
# 使用模式 B 时 CENTER_PUBLIC_BASE_URL 必须对节点可达（用于拼公开下载 URL）
CENTER_AGENT_VERSION=
CENTER_AGENT_BINARY_NAME=xrayr-agent
